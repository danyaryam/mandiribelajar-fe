# Salin file ini ke `.env` untuk dev lokal. Untuk image Docker production,
# salin ke `.env.prod` (dipakai docker compose saat build & run — lihat Dockerfile).

# Public resource directory
NEXT_PUBLIC_ASSETS_DIR=

# Galeri referensi komponen (/components) — living docs untuk dev & AI.
# Saat `yarn dev` galeri selalu tampil; di build production hanya tampil
# bila flag ini true. Deploy client: biarkan kosong → seluruh /components 404.
NEXT_PUBLIC_SHOW_COMPONENTS=true

# Backend API (Go Mandiri Belajar backend) — public URL, reachable from the browser
# Base path /api/v1 ditambahkan oleh modul lib/api (lihat endpoints.ts).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional server-only override: internal API URL for RSC/sitemap fetches
# (e.g. a k8s service DNS). Falls back to NEXT_PUBLIC_API_URL when unset.
# API_URL=http://mandiri-belajar-be.default.svc.cluster.local:8080

# Tenant — used to be sent as X-Company-Slug on legacy public /api/* endpoints.
# Mandiri Belajar catalog endpoints (/api/v1) do NOT require it; keep empty.
NEXT_PUBLIC_COMPANY_SLUG=

# Public site origin — canonical URLs, Open Graph, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:8002

# Server-only: bearer token webhook POST /api/revalidate (min 16 karakter) —
# backend/CMS memanggilnya saat konten berubah supaya cache ISR langsung segar.
# Kosongkan untuk menonaktifkan endpoint.
# REVALIDATE_TOKEN=
